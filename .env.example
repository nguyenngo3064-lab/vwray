##############################################################################
# VWRAY control plane - environment template
#
# Copy to `.env` and fill in. NEVER commit a real `.env`: it is git-ignored.
# Generate secrets with:
#   openssl rand -base64 48          -> AUTH_SECRET
#   openssl rand -base64 32          -> ENCRYPTION_KEY  (must decode to 32 bytes)
#   openssl rand -hex 24             -> GATEWAY_AGENT_TOKEN
##############################################################################

# ---------------------------------------------------------------- core -------
# development | production | test
NODE_ENV=development
# Public origin of the control plane. Used for CSRF/cookie origin checks, QR links
# inside receipts, and generated client configuration links.
APP_URL=http://localhost:3000
# Optional explicit realtime base URL. Leave empty to use the built-in SSE endpoint
# (/api/realtime/stream) on the same origin. Set this when the realtime service is
# deployed separately, e.g. wss://realtime.example.com.
WEBSOCKET_URL=

# ------------------------------------------------------------ database ------
# PostgreSQL is the transactional store: auth, sessions, quota state, traffic
# aggregates, cost records and receipts.
DATABASE_URL=postgresql://vwray:vwray_dev_pw@localhost:5432/vwray?schema=public
# Used by the test suite only. Migrations are applied here by the test bootstrap.
TEST_DATABASE_URL=postgresql://vwray:vwray_dev_pw@localhost:5432/vwray_test?schema=public
# Connection pool ceiling handed to the Prisma pool.
DATABASE_POOL_MAX=10

# ---------------------------------------------------------------- auth ------
# Signs CSRF material and rotating session-bound values. 32+ bytes, base64.
AUTH_SECRET=replace-me-with-openssl-rand-base64-48
# AES-256-GCM key for VPN credential material at rest. 32 bytes, base64.
ENCRYPTION_KEY=replace-me-with-openssl-rand-base64-32
# Session lifetimes.
SESSION_ABSOLUTE_TTL_MINUTES=720
SESSION_IDLE_TTL_MINUTES=120
# Brute-force protection.
AUTH_MAX_ATTEMPTS_PER_WINDOW=8
AUTH_ATTEMPT_WINDOW_MINUTES=15
AUTH_LOCKOUT_MINUTES=15
# When true the first-boot access code is served by POST /api/auth/bootstrap
# (development convenience only). Never enable this in production.
ALLOW_BOOTSTRAP_CODE_RETRIEVAL=false

# ------------------------------------------------------ vpn data plane ------
# Base URL + API key used by the control plane when it must CALL a gateway
# management API directly (rare: most flows let the agent pull policy instead).
VPN_API_URL=
VPN_API_KEY=
# Gateway agent ingestion. Agents authenticate with a per-node token minted in the
# VPN Nodes UI; this secret only guards the shared agent callback signature.
GATEWAY_AGENT_TOKEN=
# Reject traffic/heartbeat payloads whose clock differs from the control plane by
# more than this many seconds.
GATEWAY_MAX_CLOCK_SKEW_SECONDS=300
# Development-only mock gateway. Refused automatically when NODE_ENV=production.
DEV_MOCK_GATEWAY_ENABLED=true
DEV_MOCK_GATEWAY_BPS=0

# --------------------------------------------------------------- dns ---------
# DNS filtering provider used by the data plane:
#   none | hosts-file | dnsmasq | unbound | adguardhome | pihole
DNS_PROVIDER=none
DNS_PROVIDER_URL=
DNS_PROVIDER_API_KEY=

# --------------------------------------------------- billing simulation ------
# Simulation ONLY. No payment processor is integrated and none is implied.
BILLING_CURRENCY=VND
PRICE_PER_GB=25000
BASE_FEE=15000
FREE_QUOTA_GB=0
BILLING_PERIOD=MONTHLY
BILLING_PERIOD_START_DAY=1

# ------------------------------------------------------------ realtime ------
# Sliding windows exposed by the realtime chart, in seconds (comma separated).
REALTIME_WINDOWS=30,60,300,900
# How long raw realtime samples are buffered in memory before being discarded
# (the database keeps aggregates, not raw points).
REALTIME_BUFFER_SECONDS=1800
# Flush cadence for writing aggregated traffic to PostgreSQL.
TRAFFIC_FLUSH_INTERVAL_SECONDS=10

# ------------------------------------------------------------ retention -----
TRAFFIC_RAW_RETENTION_DAYS=2
TRAFFIC_AGGREGATE_RETENTION_DAYS=400
AUDIT_LOG_RETENTION_DAYS=730
DNS_STAT_RETENTION_DAYS=90

# ---------------------------------------------------- multi-instance ---------
# Optional. When set, realtime fan-out uses Redis pub/sub so several control-plane
# replicas share one event stream. Empty means "single process, in-memory bus".
REDIS_URL=

# ------------------------------------------------------------ gateways -------
# Path to the WireGuard interface the agent manages (data-plane host only).
WG_INTERFACE=wg0
WG_CONFIG_PATH=/etc/wireguard/wg0.conf
# Xray management endpoint (data-plane host only).
XRAY_API_URL=http://127.0.0.1:10085
XRAY_CONFIG_PATH=/etc/xray/config.json

# ------------------------------------------------------------ webhooks ------
# Optional generic alert webhook. Must be https and must not resolve to a private
# address (the SSRF guard rejects it otherwise).
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
